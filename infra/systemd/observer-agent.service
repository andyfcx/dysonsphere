[Unit]
Description=Observer Agent — distributed cron monitoring
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/observer-agent run --config /etc/observer-agent/config.yaml
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=observer-agent

[Install]
WantedBy=multi-user.target
