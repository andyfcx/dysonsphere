FROM golang:1.23-alpine AS builder
WORKDIR /workspace

COPY go.work go.work.sum ./
COPY apps/server/go.mod apps/server/go.sum ./apps/server/
COPY apps/agent/go.mod apps/agent/go.sum ./apps/agent/
COPY packages/shared/go.mod ./packages/shared/
RUN cd apps/server && go mod download

COPY apps/server ./apps/server
COPY packages/shared ./packages/shared
RUN CGO_ENABLED=0 GOOS=linux go build -o /seed ./apps/server/cmd/seed

FROM alpine:3.20
RUN apk --no-cache add ca-certificates
WORKDIR /app
COPY --from=builder /seed .
CMD ["./seed"]
